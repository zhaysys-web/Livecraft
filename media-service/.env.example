# fastapi / uvicorn runtime
MEDIA_SERVICE_HOST=0.0.0.0
MEDIA_SERVICE_PORT=8000

# 允许跨域的前端地址（逗号分隔）；本服务无 Cookie 鉴权，默认 * 支持局域网手机访问
CORS_ORIGINS=*

# 任务工作区（上传/产物存放），Docker 内默认为 /data
DATA_DIR=/tmp/livecraft-jobs
# 任务产物保留时长（秒），超时自动清理
JOB_TTL_SECONDS=86400
# 单次上传上限（MB）
MAX_UPLOAD_MB=500

# ffmpeg / ffprobe 可执行文件路径
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# 可选：第三方解析引擎兜底（POST {"url": ...} -> {"video_url": ...}）
THIRD_PARTY_RESOLVER_URL=

# 短视频解析兜底（dtk 兼容 API）：默认公开演示实例，生产建议自建
PARSER_FALLBACK_API_URL=https://api.douyin.wtf
PARSER_FALLBACK_API_KEY=
PARSER_FALLBACK_USERNAME=
PARSER_FALLBACK_PASSWORD=
PARSER_FALLBACK_DEMO=1

# 解析结果媒体代理签名；留空会自动持久化到 DATA_DIR，多 worker 时需显式固定
PARSER_PROXY_SECRET=
PARSER_PROXY_TTL_SECONDS=7200
# 反向代理后对外访问的媒体服务地址，例如 https://media.example.com
MEDIA_PUBLIC_BASE_URL=
