# fastapi / uvicorn runtime
MEDIA_SERVICE_HOST=0.0.0.0
MEDIA_SERVICE_PORT=8000

# 允许跨域的前端地址（逗号分隔）；本地开发默认放行 localhost
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 任务工作区（上传/产物存放），Docker 内默认为 /data
DATA_DIR=/tmp/livecraft-jobs
# 任务产物保留时长（秒），超时自动清理
JOB_TTL_SECONDS=86400
# 单次上传上限（MB）
MAX_UPLOAD_MB=500

# ffmpeg / ffprobe 可执行文件路径
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# 可选：第三方解析引擎兜底（POST {"url": ...} -> {"video_url": ...}）
THIRD_PARTY_RESOLVER_URL=
