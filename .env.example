# LiveCraft / 灵动映像 — 环境变量示例

# ---------- 前端（Vercel 环境变量 / Docker 构建参数）----------
# 媒体服务公网地址；NEXT_PUBLIC_* 在构建时烘焙，部署后端后先拿到地址再部署前端
# 留空时桌面自动用 localhost:8000，手机用当前访问域名的 8000 端口
NEXT_PUBLIC_MEDIA_SERVICE_URL=

# ---------- 后端 media-service（Render 环境变量 / docker-compose）----------
# Render 会自动注入 PORT，代码优先读取；本地默认 8000
MEDIA_SERVICE_PORT=8000
# 允许跨域的前端地址；本服务无 Cookie 鉴权，填 * 支持局域网手机访问
CORS_ORIGINS=*
# 转码任务与生成文件存放目录
DATA_DIR=/data
# 单文件上传上限（MB）
MAX_UPLOAD_MB=500
# 任务结果保留时长（秒），超时自动清理
JOB_TTL_SECONDS=3600
# 可选：第三方解析服务地址，留空则仅用内置解析策略
THIRD_PARTY_RESOLVER_URL=

# 短视频解析兜底（dtk 兼容 API）；公网演示实例可能限流，生产建议自建
PARSER_FALLBACK_API_URL=https://api.douyin.wtf
PARSER_FALLBACK_API_KEY=
PARSER_FALLBACK_USERNAME=
PARSER_FALLBACK_PASSWORD=
PARSER_FALLBACK_DEMO=1

# 解析结果媒体代理签名；留空会自动持久化，多 worker 时需显式固定
PARSER_PROXY_SECRET=
PARSER_PROXY_TTL_SECONDS=7200
# 反向代理后的媒体服务公网地址（留空则按请求 Host 自动生成）
MEDIA_PUBLIC_BASE_URL=
